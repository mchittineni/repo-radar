# Normalise line endings: LF in the repository, native on checkout.
* text=auto eol=lf

# Explicit text types
*.py     text diff=python
*.sh     text eol=lf
*.md     text diff=markdown
*.json   text
*.yml    text
*.yaml   text
*.toml   text
*.cfg    text
LICENSE  text
.gitattributes text
.gitignore     text
.editorconfig  text

# Binary types — never diffed or line-ending converted
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary

# Generated output: collapse in pull-request diffs and keep it out of language stats.
README.md               linguist-generated=true
data/repos.json         linguist-generated=true
data/repo-metadata.json linguist-generated=true

# Keep the tracker's own source counted as the project's language.
scripts/*.py linguist-detectable=true

# Never ship development-only files in a source archive.
.github/        export-ignore
.editorconfig   export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.pre-commit-config.yaml export-ignore
CODE_OF_CONDUCT.md      export-ignore
CONTRIBUTING.md         export-ignore
