# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing double spaces for hard line breaks.
trim_trailing_whitespace = false

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab

[{LICENSE,*.bak}]
insert_final_newline = false
trim_trailing_whitespace = false
